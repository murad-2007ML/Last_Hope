  stage3_Rescuer: {fileID: 8300000, guid: aad620607e9244ccfb56286121fa10e1, type: 3}
  stage4_Rescuer: {fileID: 8300000, guid: b9407722a0cad4c09858253972f4af85, type: 3}
  panic_Murad: {fileID: 8300000, guid: 3e0a01b4decc240b986bff9e0bc353f5, type: 3}
  ending_Rescuer: {fileID: 8300000, guid: 95fbccc10a4ef41b79c6dd27e47a726b, type: 3}
  stage4_DoorOverride: {fileID: 8300000, guid: d404ae33e6ea74aff8d1aa9da8b64c4d, type: 3}
  ending_Player: {fileID: 8300000, guid: e307b8423f04247ee9898bb5a50ac65c, type: 3}
  rescuer_02_broken: {fileID: 8300000, guid: d404ae33e6ea74aff8d1aa9da8b64c4d, type: 3}
  murad_02_water: {fileID: 8300000, guid: 3e0a01b4decc240b986bff9e0bc353f5, type: 3}
  murad_03_valve: {fileID: 8300000, guid: e307b8423f04247ee9898bb5a50ac65c, type: 3}
  murad_04_end: {fileID: 8300000, guid: fdb58d70bf74c4cc29950ee76c20d086, type: 3}
  dialogueEntries:
  - id: Intro_Murad
    speaker: 0
    audioClip: {fileID: 8300000, guid: 05785639af7794e899e4c679b6edbcdc, type: 3}
    exactTranscriptText: "You're awake... My leg is trapped under this concrete. Turn on your flashlight\u2014check the radio!"
  - id: Stage1_Rescuer
    speaker: 1
    audioClip: {fileID: 8300000, guid: f568d4c3c65b84be2b3945234a58f842, type: 3}
    exactTranscriptText: Hello?! Can you hear me? Signal's dying! Combine the two maintenance notes for the backup frequency and lock the dial!
  - id: Stage2_Rescuer
    speaker: 1
    audioClip: {fileID: 8300000, guid: 3b3e8f06ccc6b4861bcaf062233f97af, type: 3}
    exactTranscriptText: "I hear you! Magnetic lock's jammed. Check the wall clock and circuit note\u2014cut the fuse wires in exact order!"
  - id: Stage3_Rescuer
    speaker: 1
    audioClip: {fileID: 8300000, guid: aad620607e9244ccfb56286121fa10e1, type: 3}
    exactTranscriptText: "First lock's open! Water pressure's jamming the second. Listen for my wrench knocking\u2014find that valve and bleed pressure three times!"
  - id: Stage4_Rescuer
    speaker: 1
    audioClip: {fileID: 8300000, guid: b9407722a0cad4c09858253972f4af85, type: 3}
    exactTranscriptText: One lock left! Get the four-digit code from the chalk sun and the floating photo. Hurry, water's rising!
  - id: Panic_Murad
    speaker: 0
    audioClip: {fileID: 8300000, guid: 3e0a01b4decc240b986bff9e0bc353f5, type: 3}
    exactTranscriptText: Look at me! Don't panic. Hold Space and breathe with me... in... and out...
  - id: Stage4_DoorOverride
    speaker: 1
    audioClip: {fileID: 8300000, guid: d404ae33e6ea74aff8d1aa9da8b64c4d, type: 3}
    exactTranscriptText: "Code accepted! Hydraulic override active\u2014fifteen seconds till the door opens!"
  - id: Ending_Player
    speaker: 2
    audioClip: {fileID: 8300000, guid: e307b8423f04247ee9898bb5a50ac65c, type: 3}
    exactTranscriptText: Wait! What about Murad?! Get him out too!
  - id: Ending_Rescuer
    speaker: 1
    audioClip: {fileID: 8300000, guid: 95fbccc10a4ef41b79c6dd27e47a726b, type: 3}
    exactTranscriptText: Calm down, you're safe. Look at the corner... Nobody else was in there.
  - id: rescuer_02_broken
    speaker: 1
    audioClip: {fileID: 8300000, guid: d404ae33e6ea74aff8d1aa9da8b64c4d, type: 3}
    exactTranscriptText: "Code accepted! Hydraulic override active\u2014fifteen seconds till the door opens!"
  - id: murad_02_water
    speaker: 0
    audioClip: {fileID: 8300000, guid: 3e0a01b4decc240b986bff9e0bc353f5, type: 3}
    exactTranscriptText: Look at me! Don't panic. Hold Space and breathe with me... in... and out...
  - id: murad_03_valve
    speaker: 2
    audioClip: {fileID: 8300000, guid: e307b8423f04247ee9898bb5a50ac65c, type: 3}
    exactTranscriptText: Wait! What about Murad?! Get him out too!
  - id: murad_04_end
    speaker: 0
    audioClip: {fileID: 8300000, guid: fdb58d70bf74c4cc29950ee76c20d086, type: 3}
    exactTranscriptText: (unused)
